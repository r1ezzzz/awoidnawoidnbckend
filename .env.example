# API Key Proxy Configuration
# Copy this to .env and fill in your values

# Master password for encrypting/decrypting API keys
MASTER_PASSWORD=your_strong_master_password_here

# Port for the proxy server (Render uses PORT env var automatically)
PORT=3456

# Admin UI credentials
ADMIN_USER=admin
ADMIN_PASSWORD=your_admin_password_here

# CORS: comma-separated allowed origins (use * for all, or specific URLs)
# Example: https://r1ezzzz.github.io,http://localhost:3000
CORS_ORIGINS=*
